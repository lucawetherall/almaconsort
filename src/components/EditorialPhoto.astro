---
import { Image } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;         // italic serif line below the plate
  ratio?: string;           // CSS aspect-ratio for the plate, default 16 / 9
  widths?: number[];
  sizes?: string;
  loading?: 'lazy' | 'eager';
  position?: string;        // object-position, e.g. 'center 30%'
}

const {
  src,
  alt,
  caption,
  ratio = '16 / 9',
  widths = [600, 900, 1200, 1600, 2200],
  sizes = '(max-width: 1100px) 100vw, 1100px',
  loading = 'lazy',
  position = 'center',
} = Astro.props;
---
<figure class="editorial-photo">
  <div class="plate" style={`aspect-ratio: ${ratio}`}>
    <Image
      src={src}
      alt={alt}
      widths={widths}
      sizes={sizes}
      loading={loading}
      style={`object-position: ${position}`}
    />
  </div>
  {caption && <figcaption set:html={caption} />}
</figure>

<style>
  .editorial-photo { margin: 0; }
  .plate {
    position: relative;
    overflow: hidden;
    border-radius: 1px;
    border: 1px solid var(--color-border-strong);
    background: var(--color-bg-tint);
  }
  .plate :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  figcaption {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--color-text-muted);
    padding: 12px 2px 0;
  }
</style>
