---
const currentPath = Astro.url.pathname;

const base = import.meta.env.BASE_URL;

const navLinks = [
  { href: `${base}about/`, label: 'About' },
  { href: `${base}scholars/`, label: 'Scholars' },
  { href: `${base}recording/`, label: 'Recording' },
  { href: `${base}events/`, label: 'Events' },
  { href: `${base}blog/`, label: 'News' },
  { href: `${base}work-with-us/`, label: 'Work With Us' },
  { href: `${base}support/`, label: 'Support' },
  { href: `${base}contact/`, label: 'Contact' },
];
---
<header class="site-header">
  <div class="site-container header-inner">
    <a href={base} class="header-brand" aria-label="Alma Consort home">
      <img src={`${base}logo.png`} alt="" class="brand-logo" aria-hidden="true" />
      <span class="brand-name">Alma Consort</span>
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-hidden="true" />
    <label for="nav-toggle" class="nav-toggle-label" aria-label="Toggle navigation menu">
      <span></span>
      <span></span>
      <span></span>
    </label>

    <nav aria-label="Main navigation" class="main-nav">
      <ul>
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[{ active: currentPath.startsWith(link.href) }]}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid rgba(60, 60, 60, 0.15);
    padding: 1rem 0;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .header-brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--color-heading);
  }

  .header-brand:hover {
    color: var(--color-accent);
  }

  .brand-logo {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: none;
    outline: none;
  }

  .brand-name {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-variant: small-caps;
    letter-spacing: 0.08em;
    font-weight: 600;
  }

  /* Nav */
  .main-nav ul {
    display: flex;
    list-style: none;
    gap: 2rem;
  }

  .main-nav a {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    text-decoration: none;
    color: var(--color-text);
    transition: color 0.2s;
    white-space: nowrap;
  }

  .main-nav a:hover,
  .main-nav a.active {
    color: var(--color-accent);
  }

  .main-nav a:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* Mobile toggle */
  .nav-toggle {
    display: none;
  }

  .nav-toggle-label {
    display: none;
    flex-direction: column;
    gap: 5px;
    cursor: pointer;
    padding: 0.5rem;
  }

  .nav-toggle-label span {
    display: block;
    width: 24px;
    height: 2px;
    background-color: var(--color-text);
    transition: transform 0.3s, opacity 0.3s;
  }

  :global(.hamburger-mode) .nav-toggle-label {
    display: flex;
  }

  :global(.hamburger-mode) .main-nav {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--color-bg);
    border-bottom: 1px solid rgba(60, 60, 60, 0.15);
    z-index: 100;
  }

  :global(.hamburger-mode) .site-header {
    position: relative;
  }

  :global(.hamburger-mode) .main-nav ul {
    flex-direction: column;
    gap: 0;
    padding: 1rem 1.5rem;
  }

  :global(.hamburger-mode) .main-nav li {
    padding: 0.5rem 0;
  }

  :global(.hamburger-mode) .nav-toggle:checked ~ .main-nav {
    display: block;
  }

  :global(.hamburger-mode) .nav-toggle:checked ~ .nav-toggle-label span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  :global(.hamburger-mode) .nav-toggle:checked ~ .nav-toggle-label span:nth-child(2) {
    opacity: 0;
  }

  :global(.hamburger-mode) .nav-toggle:checked ~ .nav-toggle-label span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }
</style>

<script>
  function checkNavFit() {
    const header = document.querySelector('.site-header');
    const headerInner = document.querySelector('.header-inner');
    const nav = document.querySelector('.main-nav');
    const brand = document.querySelector('.header-brand');
    const toggleLabel = document.querySelector('.nav-toggle-label');
    if (!header || !headerInner || !nav || !brand || !toggleLabel) return;

    // Temporarily show as inline nav to measure
    header.classList.remove('hamburger-mode');

    const brandWidth = brand.offsetWidth;
    const toggleWidth = toggleLabel.offsetWidth || 40; // fallback for when hidden
    const headerPadding = 32; // approximate horizontal padding
    const gap = 32; // space between brand and nav
    const availableWidth = headerInner.clientWidth - brandWidth - gap - headerPadding;

    const navUl = nav.querySelector('ul');
    if (!navUl) return;

    // Measure the natural width the nav needs
    let navNeeded = 0;
    const items = navUl.querySelectorAll('li');
    const navGap = parseFloat(getComputedStyle(navUl).gap) || 32;
    items.forEach((item, i) => {
      navNeeded += item.scrollWidth;
      if (i < items.length - 1) navNeeded += navGap;
    });

    if (navNeeded > availableWidth) {
      header.classList.add('hamburger-mode');
    }
  }

  // Run on load and resize
  checkNavFit();
  window.addEventListener('resize', checkNavFit);
</script>
