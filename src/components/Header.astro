---
const currentPath = Astro.url.pathname;

const base = import.meta.env.BASE_URL;

const navLinks = [
  { href: `${base}about/`, label: 'About' },
  { href: `${base}support/`, label: 'Support' },
  { href: `${base}events/`, label: 'Events' },
  { href: `${base}contact/`, label: 'Contact' },
];
---
<header class="site-header">
  <div class="site-container header-inner">
    <a href={base} class="header-brand" aria-label="Alma Consort home">
      <!-- TODO: Replace with actual logo image once added to src/assets/ -->
      <span class="brand-logo" aria-hidden="true">AC</span>
      <span class="brand-name">Alma Consort</span>
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-hidden="true" />
    <label for="nav-toggle" class="nav-toggle-label" aria-label="Toggle navigation menu">
      <span></span>
      <span></span>
      <span></span>
    </label>

    <nav aria-label="Main navigation" class="main-nav">
      <ul>
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[{ active: currentPath.startsWith(link.href) }]}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid rgba(60, 60, 60, 0.15);
    padding: 1rem 0;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .header-brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--color-heading);
  }

  .brand-logo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border: 2px solid #c4a24e;
    border-radius: 50%;
    font-family: var(--font-serif);
    font-size: 1.1rem;
    font-weight: 700;
    color: #c4a24e;
    letter-spacing: 0.05em;
  }

  .brand-name {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-variant: small-caps;
    letter-spacing: 0.08em;
    font-weight: 600;
  }

  /* Nav */
  .main-nav ul {
    display: flex;
    list-style: none;
    gap: 2rem;
  }

  .main-nav a {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    text-decoration: none;
    color: var(--color-text);
    transition: color 0.2s;
  }

  .main-nav a:hover,
  .main-nav a.active {
    color: var(--color-accent);
  }

  .main-nav a:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* Mobile toggle */
  .nav-toggle {
    display: none;
  }

  .nav-toggle-label {
    display: none;
    flex-direction: column;
    gap: 5px;
    cursor: pointer;
    padding: 0.5rem;
  }

  .nav-toggle-label span {
    display: block;
    width: 24px;
    height: 2px;
    background-color: var(--color-text);
    transition: transform 0.3s, opacity 0.3s;
  }

  @media (max-width: 768px) {
    .nav-toggle-label {
      display: flex;
    }

    .main-nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--color-bg);
      border-bottom: 1px solid rgba(60, 60, 60, 0.15);
      z-index: 100;
    }

    .site-header {
      position: relative;
    }

    .main-nav ul {
      flex-direction: column;
      gap: 0;
      padding: 1rem 1.5rem;
    }

    .main-nav li {
      padding: 0.5rem 0;
    }

    .nav-toggle:checked ~ .main-nav {
      display: block;
    }

    .nav-toggle:checked ~ .nav-toggle-label span:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }

    .nav-toggle:checked ~ .nav-toggle-label span:nth-child(2) {
      opacity: 0;
    }

    .nav-toggle:checked ~ .nav-toggle-label span:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }
  }
</style>
