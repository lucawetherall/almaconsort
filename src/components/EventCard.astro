---
interface Props {
  title: string;
  date: Date;
  startTime?: string;
  endTime?: string;
  venue: { name: string; address?: string };
  description: string;
  slug: string;
}

const { title, date, startTime, endTime, venue, description, slug } = Astro.props;

const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const month = months[date.getMonth()];
const day = date.getDate();
const year = date.getFullYear();

const timeRange = startTime && endTime ? `${startTime} – ${endTime}` : startTime || '';
const isoDate = date.toISOString().split('T')[0];
---
<article class="event-card">
  <a href={`${import.meta.env.BASE_URL}events/${slug}/`} class="event-card-link" aria-label={`${title}, ${month} ${day} ${year}, ${venue.name}`}>
    <div class="event-date-badge" aria-hidden="true">
      <span class="event-month">{month}</span>
      <span class="event-day">{day}</span>
      <span class="event-year">{year}</span>
    </div>
    <div class="event-details">
      {timeRange && <p class="event-time"><time datetime={isoDate}>{timeRange}</time></p>}
      <h3 class="event-title">{title}</h3>
      <p class="event-venue">{venue.name}{venue.address ? `, ${venue.address}` : ''}</p>
      <p class="event-excerpt">{description}</p>
    </div>
  </a>
</article>

<style>
  .event-card {
    border-bottom: 1px solid var(--color-border);
  }

  .event-card-link {
    display: flex;
    gap: 1.5rem;
    padding: 1.5rem 0.75rem;
    margin: 0 -0.75rem;
    text-decoration: none;
    color: inherit;
    border-radius: var(--radius-sm);
    transition: background-color var(--transition);
  }

  .event-card-link:hover {
    background-color: var(--color-accent-soft);
  }

  .event-card-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .event-date-badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 70px;
    padding: 0.75rem 0.5rem;
    background: var(--color-bg-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    text-align: center;
    align-self: flex-start;
    transition: border-color var(--transition);
  }

  .event-card-link:hover .event-date-badge {
    border-color: var(--color-accent);
  }

  .event-month {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-accent);
  }

  .event-day {
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .event-year {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .event-title {
    color: var(--color-heading);
    margin-bottom: 0.25rem;
    transition: color var(--transition);
  }

  .event-card-link:hover .event-title {
    color: var(--color-accent);
  }

  .event-time {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin-bottom: 0.25rem;
  }

  .event-venue {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    margin-bottom: 0.5rem;
  }

  .event-excerpt {
    font-size: 0.95rem;
    margin: 0;
    color: var(--color-text);
  }

  @media (max-width: 768px) {
    .event-card-link {
      gap: 1rem;
    }

    .event-date-badge {
      min-width: 55px;
    }
  }
</style>
