---
interface Props {
  title: string;
  date: Date;
  startTime?: string;
  endTime?: string;
  venue: { name: string; address?: string };
  description: string;
  slug: string;
}

const { title, date, startTime, endTime, venue, description, slug } = Astro.props;

const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const month = months[date.getMonth()];
const day = date.getDate();
const year = date.getFullYear();

const timeRange = startTime && endTime ? `${startTime} – ${endTime}` : startTime || '';
---
<article class="event-card">
  <div class="event-date-badge">
    <span class="event-month">{month}</span>
    <span class="event-day">{day}</span>
    <span class="event-year">{year}</span>
  </div>
  <div class="event-details">
    {timeRange && <p class="event-time">{timeRange}</p>}
    <h3><a href={`${import.meta.env.BASE_URL}events/${slug}/`}>{title}</a></h3>
    <p class="event-venue">{venue.name}{venue.address ? `, ${venue.address}` : ''}</p>
    <p class="event-excerpt">{description}</p>
  </div>
</article>

<style>
  .event-card {
    display: flex;
    gap: 1.5rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid rgba(60, 60, 60, 0.1);
  }

  .event-date-badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 70px;
    padding: 0.75rem 0.5rem;
    background: var(--color-bg-white);
    border: 1px solid rgba(60, 60, 60, 0.1);
    border-radius: 4px;
    text-align: center;
    align-self: flex-start;
  }

  .event-month {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-accent);
  }

  .event-day {
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .event-year {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .event-details h3 {
    margin-bottom: 0.25rem;
  }

  .event-details h3 a {
    text-decoration: none;
    color: var(--color-heading);
  }

  .event-details h3 a:hover {
    color: var(--color-accent);
  }

  .event-time {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin-bottom: 0.25rem;
  }

  .event-venue {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    margin-bottom: 0.5rem;
  }

  .event-excerpt {
    font-size: 0.95rem;
    margin: 0;
  }

  @media (max-width: 768px) {
    .event-card {
      gap: 1rem;
    }

    .event-date-badge {
      min-width: 55px;
    }
  }
</style>
