---
import Newsletter from './Newsletter.astro';

const year = new Date().getFullYear();

const base = import.meta.env.BASE_URL;

const navLinks = [
  { href: `${base}about/`, label: 'About' },
  { href: `${base}scholars/`, label: 'Scholars' },
  { href: `${base}recording/`, label: 'Recording' },
  { href: `${base}events/`, label: 'Events' },
  { href: `${base}gallery/`, label: 'Gallery' },
  { href: `${base}blog/`, label: 'News' },
  { href: `${base}work-with-us/`, label: 'Work With Us' },
  { href: `${base}support/`, label: 'Support' },
  { href: `${base}contact/`, label: 'Contact' },
];

// TODO: Replace '#' with your actual social media profile URLs
const socialLinks = [
  { href: '#', label: 'Instagram', icon: 'M7.8 2h8.4C19.4 2 22 4.6 22 7.8v8.4a5.8 5.8 0 0 1-5.8 5.8H7.8C4.6 22 2 19.4 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2m-.2 2A3.6 3.6 0 0 0 4 7.6v8.8C4 18.39 5.61 20 7.6 20h8.8a3.6 3.6 0 0 0 3.6-3.6V7.6C20 5.61 18.39 4 16.4 4H7.6m9.65 1.5a1.25 1.25 0 0 1 1.25 1.25A1.25 1.25 0 0 1 17.25 8 1.25 1.25 0 0 1 16 6.75a1.25 1.25 0 0 1 1.25-1.25M12 7a5 5 0 0 1 5 5 5 5 0 0 1-5 5 5 5 0 0 1-5-5 5 5 0 0 1 5-5m0 2a3 3 0 0 0-3 3 3 3 0 0 0 3 3 3 3 0 0 0 3-3 3 3 0 0 0-3-3z' },
  { href: '#', label: 'YouTube', icon: 'M10 15l5.19-3L10 9v6m11.56-7.83c.13.47.22 1.1.28 1.9.07.8.1 1.49.1 2.09L22 12c0 2.19-.16 3.8-.44 4.83-.25.9-.83 1.48-1.73 1.73-.47.13-1.33.22-2.65.28-1.3.07-2.49.1-3.59.1L12 19c-4.19 0-6.8-.16-7.83-.44-.9-.25-1.48-.83-1.73-1.73-.13-.47-.22-1.1-.28-1.9-.07-.8-.1-1.49-.1-2.09L2 12c0-2.19.16-3.8.44-4.83.25-.9.83-1.48 1.73-1.73.47-.13 1.33-.22 2.65-.28 1.3-.07 2.49-.1 3.59-.1L12 5c4.19 0 6.8.16 7.83.44.9.25 1.48.83 1.73 1.73z' },
  { href: '#', label: 'Facebook', icon: 'M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z' },
];
---
<footer class="site-footer">
  <div class="site-container footer-inner">
    <div class="footer-main">
      <nav aria-label="Footer navigation">
        <ul>
          {navLinks.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </nav>

      <div class="footer-right">
        <div class="social-links">
          {socialLinks.map((link) => (
            <a href={link.href} aria-label={link.label} target="_blank" rel="noopener noreferrer">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d={link.icon} />
              </svg>
            </a>
          ))}
        </div>
        <p class="footer-copy">Alma Consort &copy; {year}</p>
      </div>
    </div>

    <div class="footer-newsletter">
      <Newsletter />
    </div>
  </div>
  <div class="footer-stripe" aria-hidden="true">
    <span class="stripe-blue"></span>
    <span class="stripe-teal"></span>
    <span class="stripe-yellow"></span>
    <span class="stripe-coral"></span>
    <span class="stripe-pink"></span>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 3rem;
    border-top: 1px solid rgba(60, 60, 60, 0.15);
  }

  .footer-inner {
    padding-top: 1.5rem;
    padding-bottom: 1.5rem;
  }

  .footer-main {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .footer-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.75rem;
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    list-style: none;
    gap: 1.25rem;
  }

  nav a {
    font-family: var(--font-serif);
    font-size: 0.95rem;
    text-decoration: none;
    color: var(--color-text);
  }

  nav a:hover {
    color: var(--color-accent);
  }

  nav a:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .social-links {
    display: flex;
    gap: 0.75rem;
  }

  .social-links a {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }

  .social-links a:hover {
    color: var(--color-accent);
  }

  .footer-copy {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .footer-newsletter {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(60, 60, 60, 0.08);
  }

  .footer-stripe {
    display: flex;
    height: 6px;
  }

  .footer-stripe span {
    flex: 1;
  }

  .stripe-blue { background: var(--stripe-blue); }
  .stripe-teal { background: var(--stripe-teal); }
  .stripe-yellow { background: var(--stripe-yellow); }
  .stripe-coral { background: var(--stripe-coral); }
  .stripe-pink { background: var(--stripe-pink); }

  @media (max-width: 768px) {
    .footer-main {
      flex-direction: column;
      gap: 1.25rem;
      align-items: center;
      text-align: center;
    }

    .footer-right {
      align-items: center;
    }

    nav ul {
      justify-content: center;
    }
  }
</style>
