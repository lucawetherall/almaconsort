---
<footer class="site-footer">
  <div class="site-container footer-inner">
    <nav aria-label="Footer navigation">
      <ul>
        {navLinks.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="footer-bottom">
      <div class="social-links">
        {socialLinks.map((link) => (
          <a href={link.href} aria-label={link.label} target="_blank" rel="noopener noreferrer">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d={link.icon} />
            </svg>
          </a>
        ))}
      </div>
      <p class="footer-copy">&copy; {year} Alma Consort</p>
    </div>
  </div>
  <div class="footer-stripe" aria-hidden="true">
    <span class="stripe-blue"></span>
    <span class="stripe-teal"></span>
    <span class="stripe-yellow"></span>
    <span class="stripe-coral"></span>
    <span class="stripe-pink"></span>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border-strong);
    margin-top: 1rem;
  }

  .footer-inner {
    padding: 1.75rem 1.5rem 1.25rem;
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    list-style: none;
    gap: 0.5rem 1.25rem;
    margin-bottom: 1.25rem;
  }

  nav a {
    font-family: var(--font-serif);
    font-size: 0.95rem;
    text-decoration: none;
    color: var(--color-text);
    transition: color var(--transition);
  }

  nav a:hover {
    color: var(--color-accent);
  }

  nav a:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-radius: 2px;
  }

  .footer-bottom {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1.25rem;
  }

  .social-links {
    display: flex;
    gap: 0.25rem;
  }

  .social-links a {
    color: var(--color-text-muted);
    text-decoration: none;
    width: 32px;
    height: 32px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    transition: color var(--transition), background-color var(--transition);
  }

  .social-links a:hover {
    color: var(--color-accent);
    background-color: var(--color-accent-soft);
  }

  .social-links a:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .footer-copy {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin: 0;
    font-variant: small-caps;
    letter-spacing: 0.06em;
  }

  .footer-stripe {
    display: flex;
    height: 6px;
  }

  .footer-stripe span {
    flex: 1;
  }

  .stripe-blue { background: var(--stripe-blue); }
  .stripe-teal { background: var(--stripe-teal); }
  .stripe-yellow { background: var(--stripe-yellow); }
  .stripe-coral { background: var(--stripe-coral); }
  .stripe-pink { background: var(--stripe-pink); }

  @media (max-width: 768px) {
    nav ul {
      gap: 0.5rem 1rem;
    }

    .footer-bottom {
      flex-direction: column;
      gap: 0.75rem;
    }
  }
</style>
