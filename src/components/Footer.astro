---
const year = new Date().getFullYear();

const base = import.meta.env.BASE_URL;

const navLinks = [
  { href: `${base}about/`, label: 'About' },
  { href: `${base}support/`, label: 'Support' },
  { href: `${base}events/`, label: 'Events' },
  { href: `${base}contact/`, label: 'Contact' },
];
---
<footer class="site-footer">
  <div class="site-container footer-inner">
    <nav aria-label="Footer navigation">
      <ul>
        {navLinks.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>
    <p class="footer-copy">Alma Consort &copy; {year}</p>
  </div>
  <div class="footer-stripe" aria-hidden="true">
    <span class="stripe-blue"></span>
    <span class="stripe-teal"></span>
    <span class="stripe-yellow"></span>
    <span class="stripe-coral"></span>
    <span class="stripe-pink"></span>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 3rem;
    border-top: 1px solid rgba(60, 60, 60, 0.15);
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1.5rem;
    padding-bottom: 1.5rem;
  }

  nav ul {
    display: flex;
    list-style: none;
    gap: 1.5rem;
  }

  nav a {
    font-family: var(--font-serif);
    font-size: 0.95rem;
    text-decoration: none;
    color: var(--color-text);
  }

  nav a:hover {
    color: var(--color-accent);
  }

  nav a:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .footer-copy {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .footer-stripe {
    display: flex;
    height: 6px;
  }

  .footer-stripe span {
    flex: 1;
  }

  .stripe-blue { background: var(--stripe-blue); }
  .stripe-teal { background: var(--stripe-teal); }
  .stripe-yellow { background: var(--stripe-yellow); }
  .stripe-coral { background: var(--stripe-coral); }
  .stripe-pink { background: var(--stripe-pink); }

  @media (max-width: 768px) {
    .footer-inner {
      flex-direction: column;
      gap: 1rem;
      text-align: center;
    }

    nav ul {
      flex-wrap: wrap;
      justify-content: center;
    }
  }
</style>
