---
const year = new Date().getFullYear();

const base = import.meta.env.BASE_URL;

const navLinks = [
  { href: `${base}about/`, label: 'About' },
  { href: `${base}scholars/`, label: 'Scholars' },
  { href: `${base}recording/`, label: 'Recording' },
  { href: `${base}events/`, label: 'Events' },
  { href: `${base}blog/`, label: 'News' },
  { href: `${base}work-with-us/`, label: 'Work With Us' },
  { href: `${base}support/`, label: 'Support' },
  { href: `${base}contact/`, label: 'Contact' },
];

// Add entries here once social profiles exist. Example:
// { href: 'https://www.instagram.com/almaconsort/', label: 'Instagram', icon: 'M12 2.163c3.204…' }
// Also update sameAs[] in src/layouts/BaseLayout.astro PerformingGroup schema.
const socialLinks: { href: string; label: string; icon: string }[] = [];
---
<footer class="site-footer">
  <div class="site-container footer-inner">
    <nav aria-label="Footer navigation">
      <ul>
        {navLinks.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="footer-bottom">
      <div class="social-links">
        {socialLinks.map((link) => (
          <a href={link.href} aria-label={link.label} target="_blank" rel="noopener noreferrer">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d={link.icon} />
            </svg>
          </a>
        ))}
      </div>
      <p class="footer-copy">Alma Consort &copy; {year}</p>
    </div>
  </div>
  <div class="footer-stripe" aria-hidden="true">
    <span class="stripe-blue"></span>
    <span class="stripe-teal"></span>
    <span class="stripe-yellow"></span>
    <span class="stripe-coral"></span>
    <span class="stripe-pink"></span>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid rgba(60, 60, 60, 0.15);
  }

  .footer-inner {
    padding: 1.25rem 1.5rem;
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    list-style: none;
    gap: 1.25rem;
    margin-bottom: 0.75rem;
  }

  nav a {
    font-family: var(--font-serif);
    font-size: 0.95rem;
    text-decoration: none;
    color: var(--color-text);
  }

  nav a:hover {
    color: var(--color-accent);
  }

  nav a:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .footer-bottom {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1.25rem;
  }

  .social-links {
    display: flex;
    gap: 0.6rem;
  }

  .social-links a {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }

  .social-links a:hover {
    color: var(--color-accent);
  }

  .footer-copy {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .footer-stripe {
    display: flex;
    height: 6px;
  }

  .footer-stripe span {
    flex: 1;
  }

  .stripe-blue { background: var(--stripe-blue); }
  .stripe-teal { background: var(--stripe-teal); }
  .stripe-yellow { background: var(--stripe-yellow); }
  .stripe-coral { background: var(--stripe-coral); }
  .stripe-pink { background: var(--stripe-pink); }

  @media (max-width: 768px) {
    nav ul {
      gap: 0.75rem 1rem;
    }

    .footer-bottom {
      flex-direction: column;
      gap: 0.5rem;
    }
  }
</style>
