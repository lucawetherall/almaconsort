---
interface Props {
  title: string;
  slug: string;
  tagline: string;
  cardImage?: string;
}

const { title, slug, tagline, cardImage } = Astro.props;
---
<a href={`${import.meta.env.BASE_URL}support/${slug}/`} class="tier-card" aria-label={`Become a ${title}`}>
  <div class="tier-card-media">
    {cardImage ? (
      <img src={cardImage} alt="" class="tier-card-img" loading="lazy" />
    ) : (
      <div class="tier-card-placeholder" aria-hidden="true"></div>
    )}
  </div>
  <div class="tier-card-body">
    <p class="tier-eyebrow">Become a</p>
    <h3>{title}</h3>
    <p class="tier-tagline">{tagline}</p>
    <span class="tier-cta">Learn more <span aria-hidden="true">→</span></span>
  </div>
</a>

<style>
  .tier-card {
    display: flex;
    flex-direction: column;
    background: var(--color-bg-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    text-decoration: none;
    color: var(--color-text);
    box-shadow: var(--shadow-card);
    transition: border-color var(--transition), box-shadow var(--transition), transform var(--transition);
  }

  .tier-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-border-strong);
    box-shadow: var(--shadow-card-hover);
  }

  .tier-card:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .tier-card-media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-bg-tint);
  }

  .tier-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .tier-card:hover .tier-card-img {
    transform: scale(1.03);
  }

  .tier-card-placeholder {
    width: 100%;
    height: 100%;
    background: var(--color-accent-soft);
  }

  .tier-card-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .tier-eyebrow {
    font-family: var(--font-serif);
    font-size: 0.8rem;
    font-variant: small-caps;
    letter-spacing: 0.12em;
    color: var(--color-text-muted);
    margin: 0;
  }

  .tier-card-body h3 {
    font-family: var(--font-serif);
    font-size: 1.75rem;
    font-variant: small-caps;
    letter-spacing: 0.05em;
    color: var(--color-heading);
    margin: 0 0 0.25rem;
    line-height: 1.1;
  }

  .tier-tagline {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    margin: 0 0 0.75rem;
    line-height: 1.5;
  }

  .tier-cta {
    font-family: var(--font-serif);
    font-size: 0.95rem;
    font-variant: small-caps;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    margin-top: auto;
  }

  .tier-card:hover .tier-cta {
    color: var(--color-accent-hover);
  }
</style>
