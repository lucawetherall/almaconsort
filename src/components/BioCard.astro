---
interface Props {
  name: string;
  role?: string;
  image?: string;
  initials?: string;
  bio: string;
}

const { name, role, image, initials, bio } = Astro.props;
const resolvedInitials = initials || name.split(' ').map(w => w[0]).join('');
---
<div class="bio-card">
  <div class="bio-card-image">
    {image ? (
      <img src={image} alt={`${name}, ${role ?? ''}`.trim().replace(/,\s*$/, '')} class="bio-photo" loading="lazy" />
    ) : (
      <div class="bio-placeholder" aria-hidden="true">
        <span>{resolvedInitials}</span>
      </div>
    )}
  </div>
  <div class="bio-card-text">
    <h3 class="bio-name">{name}</h3>
    {role && <p class="bio-role">{role}</p>}
    <p class="bio-body">{bio}</p>
  </div>
</div>

<style>
  .bio-card {
    display: flex;
    gap: 1.75rem;
    margin-bottom: 2.5rem;
  }

  .bio-card-image {
    flex-shrink: 0;
    width: 140px;
  }

  .bio-photo {
    width: 140px;
    height: 175px;
    object-fit: cover;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
  }

  .bio-placeholder {
    width: 140px;
    height: 175px;
    background:
      radial-gradient(120% 100% at 50% 0%, #f1ecdf 0%, #ede8db 60%, #e4dec9 100%);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--shadow-card);
  }

  .bio-placeholder span {
    font-family: var(--font-serif);
    font-size: 2.2rem;
    font-variant: small-caps;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }

  .bio-name {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-variant: small-caps;
    letter-spacing: 0.06em;
    margin-bottom: 0.15rem;
  }

  .bio-role {
    font-size: 0.85rem;
    color: var(--color-accent);
    font-variant: small-caps;
    letter-spacing: 0.1em;
    margin-bottom: 0.85rem;
  }

  .bio-body {
    font-size: 1rem;
    line-height: 1.7;
    margin: 0;
  }

  @media (max-width: 768px) {
    .bio-card {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .bio-card-text {
      text-align: left;
    }
  }
</style>
