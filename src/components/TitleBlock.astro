---
interface Props {
  title: string;
  pitch?: string;  // may contain <span class="accent">…</span>
}
const { title, pitch } = Astro.props;
---
<section class="title-block">
  <h1>{title}</h1>
  {pitch && <p class="pitch" set:html={pitch} />}
</section>

<style>
  .title-block {
    padding: 54px 0 30px;
    border-bottom: 1px solid var(--color-border-strong);
    margin: 0 0 var(--space-8);
  }
  .title-block h1 {
    font-family: var(--font-serif);
    font-size: 3.4rem;
    line-height: 1;
    font-variant: small-caps;
    letter-spacing: -0.005em;
    font-weight: 500;
    margin: 0 0 18px;
    color: var(--color-heading);
  }
  .title-block .pitch {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.35rem;
    line-height: 1.5;
    color: var(--color-text-muted);
    max-width: 50ch;
    margin: 0;
  }
  @media (max-width: 768px) {
    .title-block { padding: 36px 0 22px; }
    .title-block h1 { font-size: 2.2rem; }
    .title-block .pitch { font-size: 1.15rem; }
  }
</style>
