---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceCard from '../components/ServiceCard.astro';

const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Hire a Chamber Choir in London | Work With the Alma Consort" description="Book the Alma Consort for concerts, recordings, weddings, ceremonies, and private events. A professional chamber choir based in London, available across the UK.">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Alma Consort — Professional Choral Services",
    "description": "Hire a professional chamber choir in London for concerts, recordings, weddings, ceremonies, and corporate events.",
    "provider": {
      "@type": "PerformingGroup",
      "name": "Alma Consort",
      "url": new URL(import.meta.env.BASE_URL, Astro.site).href
    },
    "areaServed": [
      { "@type": "City", "name": "London" },
      { "@type": "Country", "name": "United Kingdom" }
    ],
    "serviceType": ["Concert Performance", "Choral Recording", "Wedding Music", "Corporate Entertainment"]
  })} />

  <div class="container">
    <h1>Work With Us</h1>

    <div class="pull-quote">
      The Alma Consort takes on concerts, recordings, private occasions, and ceremonies. Tell us what you're planning.
    </div>

    <div class="service-grid">
      <ServiceCard
        title="Concert Engagements"
        description="We perform Renaissance polyphony, Baroque sacred works, contemporary commissions, and popular arrangements. We programme for festivals, concert series, liturgical seasons, and bespoke events."
        linkUrl={`${base}contact/`}
      />

      <ServiceCard
        title="Recording Sessions"
        description="Our singers are experienced session musicians, fluent in contemporary scores and Renaissance repertoire alike. Our production team records audio and video in-house."
        linkUrl={`${base}recording/`}
        linkText="Learn more →"
      />

      <ServiceCard
        title="Private & Corporate Events"
        description="Private engagements get the same musical standard as our concerts. We tailor programmes to the occasion, drawing on classical, sacred, jazz, and popular repertoire."
        linkUrl={`${base}contact/`}
      />

      <ServiceCard
        title="Weddings & Ceremonies"
        description="We sing at weddings, civil ceremonies, and other celebrations. The music ranges from intimate settings during the ceremony to fuller choral performances at receptions. We plan with couples to match the tone of the day."
        linkUrl={`${base}contact/`}
      />
    </div>
  </div>
</BaseLayout>

<style>
  .service-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-top: 1rem;
  }

  @media (max-width: 768px) {
    .service-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
