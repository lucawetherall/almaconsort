---
import BaseLayout from '../layouts/BaseLayout.astro';
import TitleBlock from '../components/TitleBlock.astro';
import ServiceCard from '../components/ServiceCard.astro';
import EnquiryBand from '../components/EnquiryBand.astro';
import { LCS_URL, LCS_NAME } from '../lib/constants';

const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Hire a Chamber Choir in London | Work With the Alma Consort" description="Book the Alma Consort for concerts and studio recordings. A professional chamber choir based in London, available across the UK.">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Alma Consort — Professional Choral Services",
    "description": "Hire a professional chamber choir in London for concert engagements and studio recordings.",
    "provider": {
      "@type": "PerformingGroup",
      "name": "Alma Consort",
      "url": new URL(import.meta.env.BASE_URL, Astro.site).href
    },
    "areaServed": [
      { "@type": "City", "name": "London" },
      { "@type": "Country", "name": "United Kingdom" }
    ],
    "serviceType": ["Concert Performance", "Choral Recording"]
  })} />

  <div class="container">
    <TitleBlock
      title="Work With Us"
      pitch={`The Alma Consort takes on <span class="accent">concerts, recordings, and collaborations</span>. Tell us what you're planning.`}
    />

    <div class="service-grid">
      <ServiceCard
        title="Concert Engagements"
        description="We perform Renaissance polyphony, Baroque sacred works, contemporary commissions, and popular arrangements. We programme for festivals, concert series, liturgical seasons, and bespoke events."
        linkUrl={`${base}contact/`}
      />

      <ServiceCard
        title="Recording Sessions"
        description="Our singers are experienced session musicians, fluent in contemporary scores and Renaissance repertoire alike. Our production team records audio and video in-house."
        linkUrl={`${base}recording/`}
        linkText="Learn more →"
      />
    </div>

    <EnquiryBand
      title={`Weddings, funerals, and <span class="accent">private occasions</span>`}
      body={`Our sister service, ${LCS_NAME}, provides singers for ceremonies, carol services, parties, and corporate events across London.`}
      primaryHref={LCS_URL}
      primaryLabel="Visit London Choral Service"
    />
  </div>
</BaseLayout>

<style>
  .service-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-top: 1rem;
  }

  @media (max-width: 768px) {
    .service-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
