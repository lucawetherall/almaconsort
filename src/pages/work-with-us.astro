---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceCard from '../components/ServiceCard.astro';

const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Work With Us" description="Engage the Alma Consort for concerts, recordings, private events, and ceremonies — a professional chamber choir based in London.">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Alma Consort — Professional Choral Services",
    "description": "Professional chamber choir available for concerts, recordings, private events, weddings, and ceremonies in London and beyond.",
    "provider": {
      "@type": "PerformingGroup",
      "name": "Alma Consort"
    },
    "areaServed": {
      "@type": "City",
      "name": "London"
    },
    "serviceType": ["Concert Performance", "Choral Recording", "Wedding Music", "Corporate Entertainment"]
  })} />

  <div class="container">
    <h1>Work With Us</h1>

    <div class="pull-quote">
      The Alma Consort is available for a range of musical engagements. Whether you are planning a concert series, commissioning a recording, or seeking music for a private occasion, we would be glad to hear from you.
    </div>

    <div class="service-grid">
      <ServiceCard
        title="Concert Engagements"
        description="The Alma Consort performs across a wide-ranging repertoire — from Renaissance polyphony and Baroque sacred works to contemporary commissions and popular arrangements. We are experienced in programming for festivals, concert series, liturgical seasons, and bespoke events."
        linkUrl={`${base}contact/`}
      />

      <ServiceCard
        title="Recording Sessions"
        description="Our singers are experienced session musicians, equally at ease with sight-reading demanding contemporary scores and delivering nuanced performances of Renaissance repertoire. Our own production team can provide high-quality audio and video recording in-house."
        linkUrl={`${base}recording/`}
        linkText="Learn more →"
      />

      <ServiceCard
        title="Private & Corporate Events"
        description="We bring the same musicality and professionalism to private engagements as we do to the concert platform. Programmes can be tailored to suit the event, drawing on classical, sacred, jazz, and popular repertoire."
        linkUrl={`${base}contact/`}
      />

      <ServiceCard
        title="Weddings & Ceremonies"
        description="The Alma Consort provides music for weddings, civil ceremonies, and other celebrations. From intimate vocal settings during the ceremony to fuller choral performances at receptions, we work with couples to reflect the tone and significance of the occasion."
        linkUrl={`${base}contact/`}
      />
    </div>
  </div>
</BaseLayout>

<style>
  .service-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-top: 1rem;
  }

  @media (max-width: 768px) {
    .service-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
