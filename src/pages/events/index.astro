---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EventCard from '../../components/EventCard.astro';
import { getCollection } from 'astro:content';

const allEvents = (await getCollection('events')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const now = new Date();
const upcoming = allEvents
  .filter((e) => e.data.date >= now)
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
const past = allEvents.filter((e) => e.data.date < now);
---
<BaseLayout title="Events" description="Upcoming and past events from the Alma Consort.">
  <div class="container">
    <h1>Events</h1>

    {upcoming.length > 0 && (
      <section>
        <h2>Upcoming</h2>
        {upcoming.map((event) => (
          <EventCard
            title={event.data.title}
            date={event.data.date}
            startTime={event.data.startTime}
            endTime={event.data.endTime}
            venue={event.data.venue}
            description={event.data.description}
            slug={event.id}
          />
        ))}
      </section>
    )}

    {upcoming.length === 0 && (
      <p class="no-events">No upcoming events at the moment. Check back soon!</p>
    )}

    {past.length > 0 && (
      <section class="past-events">
        <h2>Latest Past Events</h2>
        {past.map((event) => (
          <EventCard
            title={event.data.title}
            date={event.data.date}
            startTime={event.data.startTime}
            endTime={event.data.endTime}
            venue={event.data.venue}
            description={event.data.description}
            slug={event.id}
          />
        ))}
      </section>
    )}
  </div>
</BaseLayout>

<style>
  section {
    margin-bottom: 3rem;
  }

  h2 {
    font-variant: small-caps;
    letter-spacing: 0.03em;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(60, 60, 60, 0.15);
  }

  .past-events {
    opacity: 0.8;
  }

  .no-events {
    padding: 2rem 0;
    color: var(--color-text-muted);
    font-style: italic;
  }
</style>
