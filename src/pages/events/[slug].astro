---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const events = await getCollection('events');
  return events.map((event) => ({
    params: { slug: event.id },
    props: { event },
  }));
}

const { event } = Astro.props;
const { Content } = await render(event);

const dateStr = event.data.date.toLocaleDateString('en-GB', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const timeRange = event.data.startTime && event.data.endTime
  ? `${event.data.startTime} – ${event.data.endTime}`
  : event.data.startTime || '';

const isoDate = event.data.date.toISOString().split('T')[0];

// Google Calendar link
const calendarTitle = encodeURIComponent(event.data.title);
const calendarDetails = encodeURIComponent(event.data.description);
const calendarLocation = encodeURIComponent(
  event.data.venue.address
    ? `${event.data.venue.name}, ${event.data.venue.address}`
    : event.data.venue.name
);
const calendarStart = event.data.startTime
  ? `${isoDate.replace(/-/g, '')}T${event.data.startTime.replace(':', '')}00`
  : isoDate.replace(/-/g, '');
const calendarEnd = event.data.endTime
  ? `${isoDate.replace(/-/g, '')}T${event.data.endTime.replace(':', '')}00`
  : calendarStart;
const googleCalendarUrl = `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${calendarTitle}&dates=${calendarStart}/${calendarEnd}&details=${calendarDetails}&location=${calendarLocation}`;

const siteOrigin = new URL(import.meta.env.BASE_URL, Astro.site).href;
const eventImageUrl = event.data.image
  ? new URL(event.data.image, Astro.site).href
  : new URL(`${import.meta.env.BASE_URL}logo.png`, Astro.site).href;

const eventJsonLd = {
  "@context": "https://schema.org",
  "@type": "MusicEvent",
  "name": event.data.title,
  "description": event.data.description,
  "startDate": event.data.startTime ? `${isoDate}T${event.data.startTime}:00` : isoDate,
  ...(event.data.endTime && { "endDate": `${isoDate}T${event.data.endTime}:00` }),
  "eventStatus": "https://schema.org/EventScheduled",
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
  "image": [eventImageUrl],
  "location": {
    "@type": "Place",
    "name": event.data.venue.name,
    ...(event.data.venue.address && {
      "address": {
        "@type": "PostalAddress",
        "streetAddress": event.data.venue.address,
        "addressLocality": "London",
        "addressCountry": "GB",
      },
    }),
  },
  "organizer": {
    "@type": "PerformingGroup",
    "name": "Alma Consort",
    "url": siteOrigin,
  },
  "performer": (event.data.performers && event.data.performers.length > 0)
    ? event.data.performers.map((p) => ({ "@type": "PerformingGroup", "name": p }))
    : [{ "@type": "PerformingGroup", "name": "Alma Consort" }],
  ...(event.data.ticketUrl && {
    "offers": {
      "@type": "Offer",
      "url": event.data.ticketUrl,
      "availability": "https://schema.org/InStock",
      "validFrom": isoDate,
    },
  }),
};

// Check if event is in the future
const isFuture = event.data.date >= new Date();

// Share URL
const eventUrl = new URL(`${import.meta.env.BASE_URL}events/${event.id}/`, Astro.site).href;
---
<BaseLayout
  title={`${event.data.title} | Alma Consort`}
  description={`${event.data.description.slice(0, 155)}${event.data.description.length > 155 ? '…' : ''} ${event.data.venue.name}, ${dateStr}.`.slice(0, 200)}
  ogImage={event.data.image}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(eventJsonLd)} />
  <div class="container">
    <h1>{event.data.title}</h1>

    <div class="event-meta">
      <p class="event-date">{dateStr}</p>
      {timeRange && <p class="event-time">{timeRange}</p>}
      <p class="event-venue">
        {event.data.venue.name}
        {event.data.venue.address && <span> &mdash; {event.data.venue.address}</span>}
      </p>
    </div>

    {event.data.ticketUrl && (
      <p>
        <a href={event.data.ticketUrl} class="btn btn-primary" target="_blank" rel="noopener noreferrer">
          Get Tickets
        </a>
      </p>
    )}

    <div class="event-body">
      <Content />
    </div>

    {event.data.performers && event.data.performers.length > 0 && (
      <div class="performers">
        <h2>Performers</h2>
        <ul>
          {event.data.performers.map((p) => <li>{p}</li>)}
        </ul>
      </div>
    )}

    {isFuture && (
      <div class="event-actions">
        <a href={googleCalendarUrl} target="_blank" rel="noopener noreferrer" class="action-link">Add to Google Calendar</a>
        <span class="action-sep">&middot;</span>
        <a href={`mailto:?subject=${calendarTitle}&body=${encodeURIComponent(`${event.data.title}\n${dateStr}\n${event.data.venue.name}\n\n${eventUrl}`)}`} class="action-link">Share via email</a>
      </div>
    )}

    <p class="back-link">
      <a href={`${import.meta.env.BASE_URL}events/`}>&larr; Back to Events</a>
    </p>
  </div>
</BaseLayout>

<style>
  .event-meta {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(60, 60, 60, 0.15);
  }

  .event-date {
    font-size: 1.15rem;
    font-weight: 600;
    margin-bottom: 0.25rem;
  }

  .event-time {
    color: var(--color-text-muted);
    margin-bottom: 0.25rem;
  }

  .event-venue {
    color: var(--color-text-muted);
  }

  .event-body {
    margin-bottom: 2rem;
    font-size: 1.1rem;
    line-height: 1.8;
  }

  .performers {
    margin-bottom: 2rem;
  }

  .performers ul {
    list-style: none;
    padding: 0;
  }

  .performers li {
    padding: 0.25rem 0;
  }

  .event-actions {
    margin: 1.5rem 0;
    padding: 1rem 0;
    border-top: 1px solid rgba(60, 60, 60, 0.1);
    font-size: 0.9rem;
  }

  .action-link {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .action-link:hover {
    color: var(--color-accent);
  }

  .action-sep {
    margin: 0 0.5rem;
    color: var(--color-text-muted);
  }

  .back-link {
    margin-top: 2rem;
  }
</style>
