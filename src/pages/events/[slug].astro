---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ConcertCard from '../../components/ConcertCard.astro';
import ProgrammeList from '../../components/ProgrammeList.astro';
import Button from '../../components/Button.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const events = await getCollection('events');
  return events.map((event) => ({
    params: { slug: event.id },
    props: { event },
  }));
}

const { event } = Astro.props;
const { Content } = await render(event);

const dateStr = event.data.date.toLocaleDateString('en-GB', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const eyebrow = `Concert · ${dateStr}`;

const timeRange = event.data.startTime && event.data.endTime
  ? `${event.data.startTime} – ${event.data.endTime}`
  : event.data.startTime || '';

const isoDate = event.data.date.toISOString().split('T')[0];

// Google Calendar link
const calendarTitle = encodeURIComponent(event.data.title);
const calendarDetails = encodeURIComponent(event.data.description);
const calendarLocation = encodeURIComponent(
  event.data.venue.address
    ? `${event.data.venue.name}, ${event.data.venue.address}`
    : event.data.venue.name
);
const calendarStart = event.data.startTime
  ? `${isoDate.replace(/-/g, '')}T${event.data.startTime.replace(':', '')}00`
  : isoDate.replace(/-/g, '');
const calendarEnd = event.data.endTime
  ? `${isoDate.replace(/-/g, '')}T${event.data.endTime.replace(':', '')}00`
  : calendarStart;
const googleCalendarUrl = `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${calendarTitle}&dates=${calendarStart}/${calendarEnd}&details=${calendarDetails}&location=${calendarLocation}`;

const siteOrigin = new URL(import.meta.env.BASE_URL, Astro.site).href;
const eventImageUrl = event.data.image
  ? new URL(event.data.image, Astro.site).href
  : new URL(`${import.meta.env.BASE_URL}og-image.png`, Astro.site).href;

const eventJsonLd = {
  "@context": "https://schema.org",
  "@type": "MusicEvent",
  "name": event.data.title,
  "description": event.data.description,
  "startDate": event.data.startTime ? `${isoDate}T${event.data.startTime}:00` : isoDate,
  ...(event.data.endTime && { "endDate": `${isoDate}T${event.data.endTime}:00` }),
  "eventStatus": "https://schema.org/EventScheduled",
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
  "image": [eventImageUrl],
  "location": {
    "@type": "Place",
    "name": event.data.venue.name,
    ...(event.data.venue.address && {
      "address": {
        "@type": "PostalAddress",
        "streetAddress": event.data.venue.address,
        "addressLocality": "London",
        "addressCountry": "GB",
      },
    }),
  },
  "organizer": {
    "@type": "PerformingGroup",
    "name": "Alma Consort",
    "url": siteOrigin,
  },
  "performer": (event.data.performers && event.data.performers.length > 0)
    ? event.data.performers.map((p) => ({ "@type": "PerformingGroup", "name": p }))
    : [{ "@type": "PerformingGroup", "name": "Alma Consort" }],
  ...(event.data.ticketUrl && {
    "offers": {
      "@type": "Offer",
      "url": event.data.ticketUrl,
      "availability": "https://schema.org/InStock",
      "validFrom": isoDate,
    },
  }),
};

const isFuture = event.data.date >= new Date();

const directedBy = (event.data.performers ?? []).find(
  (p) => p.toLowerCase().includes('director')
);

const programmeItems = (event.data.programme ?? []).map((p) => ({
  work: p.work,
  composer: p.composer,
}));

const baseUrl = import.meta.env.BASE_URL;
---
<BaseLayout
  title={`${event.data.title} | Alma Consort`}
  description={`${event.data.description.slice(0, 155)}${event.data.description.length > 155 ? '…' : ''} ${event.data.venue.name}, ${dateStr}.`.slice(0, 200)}
  ogImage={event.data.image}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(eventJsonLd)} />

  <div class="container">
    <div class="concert-hero">
      <div>
        <div class="eyebrow">{eyebrow}</div>
        <h1 set:html={event.data.title} />
        <p class="deck">{event.data.description}</p>
        <div class="actions">
          {event.data.ticketUrl && (
            <Button variant="primary" href={event.data.ticketUrl} target="_blank" rel="noopener noreferrer">
              Book tickets
            </Button>
          )}
          {isFuture && (
            <Button variant="secondary" href={googleCalendarUrl} target="_blank" rel="noopener noreferrer">
              Add to calendar
            </Button>
          )}
        </div>
      </div>
      <ConcertCard
        date={event.data.date}
        time={timeRange}
        venue={event.data.venue}
        priceFrom={event.data.priceFrom}
        directedBy={directedBy}
      />
    </div>

    {programmeItems.length > 0 && <ProgrammeList items={programmeItems} />}

    <div class="prose">
      <Content />
    </div>

    {event.data.performers && event.data.performers.length > 0 && (
      <div class="performers">
        <h2>Performers</h2>
        <ul>
          {event.data.performers.map((p) => <li>{p}</li>)}
        </ul>
      </div>
    )}

    <p class="back-link">
      <a href={`${baseUrl}events/`}>&larr; Back to Events</a>
    </p>
  </div>
</BaseLayout>

<style>
  .concert-hero {
    padding: 30px 0 40px;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 56px;
    align-items: start;
    border-bottom: 1px solid var(--color-border-strong);
    margin-bottom: 8px;
  }
  .concert-hero .eyebrow {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 16px;
    font-weight: 500;
  }
  .concert-hero h1 {
    font-family: var(--font-serif);
    font-size: 3.4rem;
    line-height: 0.98;
    letter-spacing: -0.01em;
    font-weight: 500;
    margin: 0 0 18px;
    color: var(--color-heading);
  }
  .concert-hero .deck {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.15rem;
    line-height: 1.55;
    color: var(--color-text-muted);
    max-width: 34ch;
    margin-bottom: 24px;
  }
  .actions {
    display: flex;
    gap: 14px;
    align-items: center;
    flex-wrap: wrap;
  }
  .prose {
    max-width: var(--content-width);
    margin: 24px auto 0;
    font-family: var(--font-serif);
    font-size: 1.1rem;
    line-height: 1.7;
  }
  .prose :global(p) { margin: 0 0 1rem; }
  .performers {
    max-width: var(--content-width);
    margin: 2rem auto;
  }
  .performers h2 {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-variant: small-caps;
    letter-spacing: 0.06em;
    font-weight: 500;
    color: var(--color-heading);
    margin: 0 0 0.5rem;
  }
  .performers ul { list-style: none; padding: 0; margin: 0; }
  .performers li { padding: 0.25rem 0; }
  .back-link {
    max-width: var(--content-width);
    margin: 2rem auto 0;
  }
  .back-link a {
    color: var(--color-text-muted);
    text-decoration: none;
  }
  .back-link a:hover { color: var(--color-claret); }

  @media (max-width: 768px) {
    .concert-hero { grid-template-columns: 1fr; gap: 24px; padding: 24px 0 32px; }
    .concert-hero h1 { font-size: 2.4rem; }
  }
</style>
