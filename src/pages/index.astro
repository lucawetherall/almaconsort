---
import BaseLayout from '../layouts/BaseLayout.astro';
import Newsletter from '../components/Newsletter.astro';
---
<BaseLayout title="Home" description="The Alma Consort is a professional chamber choir in London, dedicated to concerts and recordings of the highest calibre.">
  <link slot="head" rel="stylesheet" href="https://cdn.jsdelivr.net/npm/lite-youtube-embed@0.3.3/src/lite-yt-embed.min.css" />
  <script slot="head" is:inline src="https://cdn.jsdelivr.net/npm/lite-youtube-embed@0.3.3/src/lite-yt-embed.min.js"></script>
  <div class="container">
    <div class="video-wrapper">
      <lite-youtube videoid="GjNdZVs7g68" playlabel="Play: O Magnum Mysterium - Victoria (Alma Consort / Luca Wetherall)">
        <a href="https://youtube.com/watch?v=GjNdZVs7g68" class="lty-playbtn" title="Play Video">
          <span class="lyt-visually-hidden">Play Video: O Magnum Mysterium - Victoria (Alma Consort / Luca Wetherall)</span>
        </a>
      </lite-youtube>
    </div>

    <div class="home-text">
      <p>
        The <strong>Alma Consort</strong> is a professional chamber choir based in London, bringing together some of the city's finest young choral singers. We perform across a broad repertoire — from Renaissance polyphony to contemporary commissions, and from the concert platform to the recording studio.
      </p>
      <p>
        Central to our work is a commitment to <a href={`${import.meta.env.BASE_URL}recording/`}>recording</a> of the highest quality. The ensemble offers both studio sessions for external projects and produces its own recordings, with audio and video captured in-house by our dedicated production team.
      </p>
      <p>
        The Alma Consort is directed by <a href={`${import.meta.env.BASE_URL}about/`}>Luca Wetherall</a> and <a href={`${import.meta.env.BASE_URL}about/`}>Izzy Mohan</a>. Explore our upcoming <a href={`${import.meta.env.BASE_URL}events/`}>events</a>, or <a href={`${import.meta.env.BASE_URL}contact/`}>get in touch</a> to discuss a project.
      </p>
    </div>

    <div class="home-newsletter">
      <Newsletter />
    </div>
  </div>
</BaseLayout>

<style>
  .video-wrapper {
    margin-bottom: 2rem;
  }

  lite-youtube {
    max-width: 100%;
    aspect-ratio: 16 / 9;
  }

  .home-text {
    font-size: 1.1rem;
    line-height: 1.8;
  }

  .home-newsletter {
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(60, 60, 60, 0.1);
  }
</style>
