---
import BaseLayout from '../layouts/BaseLayout.astro';
import Divider from '../components/Divider.astro';
---
<BaseLayout title="Choral Recording in London | Alma Consort" description="Professional choral recording in London: studio sessions for composers, producers, and labels, with in-house audio and video production by the Alma Consort.">
  <link slot="head" rel="stylesheet" href="https://cdn.jsdelivr.net/npm/lite-youtube-embed@0.3.3/src/lite-yt-embed.min.css" />
  <script slot="head" is:inline src="https://cdn.jsdelivr.net/npm/lite-youtube-embed@0.3.3/src/lite-yt-embed.min.js"></script>

  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Alma Consort — Choral Recording",
    "description": "Professional choral recording in London. Studio sessions for composers, producers, record labels, and creative agencies, with in-house audio and video production.",
    "provider": {
      "@type": "PerformingGroup",
      "name": "Alma Consort",
      "url": new URL(import.meta.env.BASE_URL, Astro.site).href
    },
    "areaServed": [
      { "@type": "City", "name": "London" },
      { "@type": "Country", "name": "United Kingdom" }
    ],
    "serviceType": "Choral Recording",
    "audience": { "@type": "BusinessAudience", "audienceType": "Composers, producers, record labels, creative agencies" }
  })} />

  <div class="container">
    <h1>Recording</h1>

    <p>
      The Alma Consort records with the precision and musicality of concert performance. Our singers are experienced session musicians, fluent in Renaissance sacred music, film scores, jazz arrangements, and contemporary commissions.
    </p>

    <h2>Sessions</h2>

    <p>
      We work with composers, producers, record labels, and creative agencies. For each session we assemble the right forces, whether a small ensemble or a full choir, and deliver recordings that sit cleanly inside the project they're for.
    </p>

    <p>
      We take on-site and remote sessions. Our production team handles audio and video in-house, from capture through to final delivery, so artistic and technical decisions stay aligned.
    </p>

    <Divider />

    <h2>Our recordings</h2>

    <p>
      Alongside session work, we produce our own recordings. A selection of recent work:
    </p>

    <div class="recordings-grid">
      <div class="recording-item">
        <lite-youtube videoid="GjNdZVs7g68" playlabel="Play: O Magnum Mysterium - Victoria (Alma Consort / Luca Wetherall)">
          <a href="https://youtube.com/watch?v=GjNdZVs7g68" class="lty-playbtn" title="Play Video">
            <span class="lyt-visually-hidden">Play Video: O Magnum Mysterium - Victoria (Alma Consort / Luca Wetherall)</span>
          </a>
        </lite-youtube>
        <p class="recording-caption"><strong>O Magnum Mysterium</strong> — Tomás Luis de Victoria</p>
      </div>
    </div>

    <Divider />

    <div class="pull-quote">
      To discuss a recording project, please <a href={`${import.meta.env.BASE_URL}contact/`}>get in touch</a>. We welcome enquiries from composers, producers, record labels, and creative agencies.
    </div>
  </div>
</BaseLayout>

<style>
  h2 {
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }

  .recordings-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin-top: 1.5rem;
  }

  .recording-item lite-youtube {
    max-width: 100%;
    aspect-ratio: 16 / 9;
  }

  .recording-caption {
    margin-top: 0.75rem;
    font-size: 0.95rem;
    color: var(--color-text);
  }
</style>
