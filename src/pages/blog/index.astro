---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const siteOrigin = new URL(import.meta.env.BASE_URL, Astro.site).href;
const blogJsonLd = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "Alma Consort — News & Reflections",
  "description": "News and reflections from the Alma Consort on concerts, recordings, programming, and choral life.",
  "url": new URL(`${import.meta.env.BASE_URL}blog/`, Astro.site).href,
  "inLanguage": "en-GB",
  "publisher": { "@type": "Organization", "name": "Alma Consort", "url": siteOrigin },
  "blogPost": posts.map((p) => ({
    "@type": "BlogPosting",
    "headline": p.data.title,
    "description": p.data.description,
    "datePublished": p.data.date.toISOString().split('T')[0],
    "url": new URL(`${import.meta.env.BASE_URL}blog/${p.id}/`, Astro.site).href,
  })),
};
---
<BaseLayout title="News & Reflections | Alma Consort" description="News and reflections from the Alma Consort on concerts, recordings, programming, and the life of a professional chamber choir in London.">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(blogJsonLd)} />
  <div class="container">
    <h1>News</h1>

    {posts.length > 0 ? (
      <div class="blog-list">
        {posts.map((post) => (
          <BlogCard
            title={post.data.title}
            date={post.data.date}
            description={post.data.description}
            slug={post.id}
          />
        ))}
      </div>
    ) : (
      <p class="no-posts">No posts yet. Check back soon.</p>
    )}
  </div>
</BaseLayout>

<style>
  .blog-list {
    margin-top: 0.5rem;
  }

  .no-posts {
    padding: 2rem 0;
    color: var(--color-text-muted);
    font-style: italic;
  }
</style>
