---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TitleBlock from '../../components/TitleBlock.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const dateStr = post.data.date.toLocaleDateString('en-GB', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const isoDate = post.data.date.toISOString().split('T')[0];

const canonicalHref = new URL(`${import.meta.env.BASE_URL}blog/${post.id}/`, Astro.site).href;
const ogImageHref = new URL(`${import.meta.env.BASE_URL}og-image.png`, Astro.site).href;

const wordCount = (post.body ?? '').trim().split(/\s+/).filter(Boolean).length;
const readingMinutes = Math.max(1, Math.round(wordCount / 220));

const postJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "mainEntityOfPage": { "@type": "WebPage", "@id": canonicalHref },
  "headline": post.data.title,
  "description": post.data.description,
  "datePublished": isoDate,
  "dateModified": isoDate,
  "inLanguage": "en-GB",
  "image": [ogImageHref],
  "wordCount": wordCount,
  "keywords": post.data.tags && post.data.tags.length > 0 ? post.data.tags.join(', ') : undefined,
  "author": {
    "@type": post.data.author && post.data.author !== "Alma Consort" ? "Person" : "Organization",
    "name": post.data.author || "Alma Consort",
  },
  "publisher": {
    "@type": "Organization",
    "name": "Alma Consort",
    "logo": { "@type": "ImageObject", "url": new URL(`${import.meta.env.BASE_URL}logo.png`, Astro.site).href },
  },
};
---
<BaseLayout title={`${post.data.title} | Alma Consort`} description={post.data.description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(postJsonLd)} />
  <div class="container">
    <article>
      <TitleBlock title={post.data.title} />
      <p class="post-meta">
        <time datetime={isoDate}>{dateStr}</time>
        <span class="meta-sep" aria-hidden="true">·</span>
        <span>{readingMinutes} min read</span>
      </p>

      <div class="post-body">
        <Content />
      </div>
    </article>

    <p class="back-link">
      <a href={`${import.meta.env.BASE_URL}blog/`}>&larr; Back to News</a>
    </p>
  </div>
</BaseLayout>

<style>
  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    font-size: 0.95rem;
    color: var(--color-text-muted);
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border-strong);
  }

  .meta-sep {
    color: var(--color-border-strong);
  }

  .post-body {
    font-size: 1.1rem;
    line-height: 1.8;
    margin-bottom: 2rem;
  }

  .post-body :global(h2) {
    margin-top: 2rem;
  }

  .post-body :global(h3) {
    margin-top: 1.5rem;
  }

  .back-link {
    margin-top: 2rem;
  }
</style>
