---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StripeButton from '../../components/StripeButton.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const tiers = await getCollection('supportTiers');
  return tiers.map((tier) => ({
    params: { slug: tier.data.slug },
    props: { tier },
  }));
}

const { tier } = Astro.props;
const { Content } = await render(tier);
const isPatron = tier.data.slug === 'patron';
---
<BaseLayout
  title={`Become a ${tier.data.title}`}
  description={tier.data.tagline}
  includeStripe={true}
>
  <div class="container">
    <header class="tier-header">
      <p class="eyebrow">Become a</p>
      <h1>{tier.data.title}</h1>
      <p class="lede">{tier.data.tagline}</p>
    </header>

    <article class="tier-content">
      <Content />
    </article>

    <section class="pricing-section" aria-labelledby="pricing-heading">
      <div class="section-heading">
        <h2 id="pricing-heading">Choose your level</h2>
        <p>Select a tier below — you can change or cancel any time.</p>
      </div>

      <div class={`pricing-grid pricing-grid-${tier.data.stripeButtons.length}`}>
        {tier.data.stripeButtons.map((btn) => (
          <div class="pricing-card">
            <p class="pricing-tier-name">{btn.tierName}</p>
            <p class="pricing-amount">
              <span class="pricing-price">{btn.price}</span>
              <span class="pricing-period">/ month</span>
            </p>
            <p class="pricing-billing-note">{btn.billingNote ?? ' '}</p>
            {btn.highlight && <p class="pricing-highlight">{btn.highlight}</p>}
            <div class="pricing-action">
              <StripeButton buyButtonId={btn.id} />
            </div>
          </div>
        ))}
      </div>

      <p class="pricing-footnote">Secure checkout powered by Stripe.</p>
    </section>

    {isPatron && (
      <aside class="bespoke-callout" aria-label="Bespoke gifts">
        <p class="eyebrow">Bespoke gifts</p>
        <h3>Sponsor a recording, a concert, or a scholar</h3>
        <p>
          If you'd like to direct your donation toward a specific part of the Scholars programme, or to sponsor a recording or concert, <a href={`${import.meta.env.BASE_URL}contact/`}>get in touch</a> and we'll talk it through.
        </p>
      </aside>
    )}

    <section class="faq" aria-labelledby="faq-heading">
      <h2 id="faq-heading">Common questions</h2>
      <dl>
        <div class="faq-item">
          <dt>Can I cancel any time?</dt>
          <dd>Yes. You can cancel or pause your contribution whenever you like, from the receipt email Stripe sends you.</dd>
        </div>
        <div class="faq-item">
          <dt>Can I change tier later?</dt>
          <dd>Of course — cancel your current tier and start a new one, or <a href={`${import.meta.env.BASE_URL}contact/`}>email us</a> and we'll move you across.</dd>
        </div>
        <div class="faq-item">
          <dt>Is my donation Gift Aid eligible?</dt>
          <dd>The Alma Consort is not currently a registered charity, so donations are not Gift Aid eligible. Every penny still goes directly to the choir and the Scholars programme.</dd>
        </div>
        <div class="faq-item">
          <dt>How will I receive my benefits?</dt>
          <dd>Once you've signed up we'll email you with everything you need — booking codes, programme notes, and invitations to open rehearsals.</dd>
        </div>
      </dl>
    </section>

    <p class="back-link">
      <a href={`${import.meta.env.BASE_URL}support/`}>&larr; Back to Support</a>
    </p>
  </div>
</BaseLayout>

<style>
  .tier-header {
    text-align: center;
    max-width: 640px;
    margin: 0 auto 3rem;
  }

  .tier-header h1 {
    margin-bottom: 0.75rem;
  }

  .eyebrow {
    font-family: var(--font-serif);
    font-size: 0.85rem;
    font-variant: small-caps;
    letter-spacing: 0.14em;
    color: var(--color-text-muted);
    margin: 0 0 0.5rem;
  }

  .lede {
    font-size: 1.2rem;
    line-height: 1.6;
    color: var(--color-text);
    font-style: italic;
    margin: 0;
  }

  .tier-header::after {
    content: "";
    display: block;
    width: 48px;
    height: 1px;
    background: var(--color-accent);
    margin: 1.5rem auto 0;
  }

  .tier-content {
    margin-bottom: 3.5rem;
    font-size: 1.05rem;
    line-height: 1.8;
  }

  .tier-content :global(hr) {
    border: none;
    height: 1rem;
    text-align: center;
    margin: 2.5rem 0;
    overflow: visible;
  }

  .tier-content :global(hr)::before {
    content: "•   •   •";
    font-family: var(--font-serif);
    color: var(--color-accent);
    letter-spacing: 0.3em;
    font-size: 0.9rem;
  }

  .tier-content :global(h2) {
    font-variant: small-caps;
    letter-spacing: 0.03em;
    font-size: 1.5rem;
    margin-top: 2rem;
  }

  .tier-content :global(h3) {
    font-variant: small-caps;
    letter-spacing: 0.03em;
    margin-top: 1.5rem;
  }

  .tier-content :global(ul) {
    padding-left: 1.25rem;
    margin-bottom: 1.25rem;
  }

  .tier-content :global(li) {
    margin-bottom: 0.5rem;
  }

  .pricing-section {
    background: var(--color-bg-tint);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 2.5rem 2rem;
    margin-bottom: 2.5rem;
  }

  .section-heading {
    text-align: center;
    margin-bottom: 2.25rem;
  }

  .section-heading h2 {
    font-variant: small-caps;
    letter-spacing: 0.04em;
    margin-bottom: 0.75rem;
  }

  .section-heading h2::after {
    content: "";
    display: block;
    width: 40px;
    height: 1px;
    background: var(--color-accent);
    margin: 0.75rem auto 0;
  }

  .section-heading p {
    color: var(--color-text-muted);
    margin: 0;
  }

  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .pricing-card {
    position: relative;
    background: var(--color-bg-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.75rem 1.25rem 1.5rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.4rem;
    transition: border-color var(--transition), box-shadow var(--transition), transform var(--transition);
  }

  .pricing-card:hover {
    border-color: var(--color-border-strong);
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-2px);
  }

  .pricing-tier-name {
    font-size: 0.85rem;
    font-variant: small-caps;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    margin: 0;
    min-height: 2.4em;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1.3;
  }

  .pricing-amount {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.25rem;
    margin: 0.25rem 0 0;
  }

  .pricing-price {
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1;
    color: var(--color-heading);
    font-variant-numeric: tabular-nums;
  }

  .pricing-period {
    font-size: 0.95rem;
    color: var(--color-text-muted);
  }

  .pricing-billing-note {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin: 0;
    min-height: 1.2em;
  }

  .pricing-highlight {
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--color-text);
    margin: 0.75rem 0 0;
    padding: 0.75rem 0.5rem 0;
    border-top: 1px solid var(--color-border);
    min-height: 4.2em;
  }

  .pricing-action {
    margin-top: 1rem;
  }

  .pricing-footnote {
    text-align: center;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin: 1.5rem 0 0;
  }

  .bespoke-callout {
    margin-top: 2.5rem;
    padding: 1.75rem 2rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-bg-white);
  }

  .bespoke-callout .eyebrow {
    font-family: var(--font-serif);
    font-size: 0.8rem;
    font-variant: small-caps;
    letter-spacing: 0.14em;
    color: var(--color-accent);
    margin: 0 0 0.5rem;
  }

  .bespoke-callout h3 {
    font-variant: small-caps;
    letter-spacing: 0.03em;
    margin-bottom: 0.5rem;
  }

  .bespoke-callout p {
    margin: 0;
    color: var(--color-text);
  }

  .faq {
    margin-top: 3.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--color-border);
  }

  .faq h2 {
    font-variant: small-caps;
    letter-spacing: 0.04em;
    text-align: center;
    margin-bottom: 2rem;
  }

  .faq h2::after {
    content: "";
    display: block;
    width: 40px;
    height: 1px;
    background: var(--color-accent);
    margin: 0.75rem auto 0;
  }

  .faq dl {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem 2rem;
    margin: 0;
  }

  .faq-item dt {
    font-weight: 600;
    color: var(--color-heading);
    margin-bottom: 0.35rem;
  }

  .faq-item dd {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 1rem;
    line-height: 1.6;
  }

  .back-link {
    margin-top: 2.5rem;
    text-align: center;
  }

  @media (max-width: 640px) {
    .faq dl {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    .pricing-section {
      padding: 2rem 1.25rem;
    }

    .pricing-grid {
      grid-template-columns: 1fr;
      max-width: 360px;
      margin: 0 auto;
    }
  }
</style>
