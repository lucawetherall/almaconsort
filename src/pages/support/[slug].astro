---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StripeButton from '../../components/StripeButton.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const tiers = await getCollection('supportTiers');
  return tiers.map((tier) => ({
    params: { slug: tier.data.slug },
    props: { tier },
  }));
}

const { tier } = Astro.props;
const { Content } = await render(tier);
---
<BaseLayout
  title={`Become a ${tier.data.title}`}
  description={tier.data.tagline}
  includeStripe={true}
>
  <div class="container">
    <h1>Become a {tier.data.title}</h1>

    <div class="tier-content">
      <Content />
    </div>

    <div class="pricing-grid">
      {tier.data.stripeButtons.map((btn) => (
        <div class="pricing-card">
          <p class="pricing-tier-name">{btn.tierName}</p>
          <div class="pricing-amount">
            <span class="pricing-price">{btn.price}</span>
            <span class="pricing-period">per<br />month</span>
          </div>
          {btn.billingNote && <p class="pricing-billing-note">{btn.billingNote}</p>}
          <StripeButton buyButtonId={btn.id} />
        </div>
      ))}
    </div>

    <p class="back-link">
      <a href={`${import.meta.env.BASE_URL}support/`}>&larr; Back to Support</a>
    </p>
  </div>
</BaseLayout>

<style>
  .tier-content {
    margin-bottom: 2.5rem;
    font-size: 1.1rem;
    line-height: 1.8;
  }

  .tier-content :global(hr) {
    border: none;
    border-top: 1px solid rgba(60, 60, 60, 0.15);
    margin: 2.5rem 0;
  }

  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .pricing-card {
    border: 1px solid #d4d0c8;
    border-radius: 6px;
    padding: 1.5rem 1rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
  }

  .pricing-tier-name {
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .pricing-amount {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 0.2rem;
    margin-bottom: 0.25rem;
  }

  .pricing-price {
    font-size: 2.2rem;
    font-weight: 700;
    line-height: 1;
  }

  .pricing-period {
    font-size: 0.8rem;
    line-height: 1.2;
    color: var(--color-text-muted);
    padding-top: 0.2rem;
  }

  .pricing-billing-note {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin-bottom: 0.5rem;
  }

  .back-link {
    margin-top: 2rem;
  }

  @media (max-width: 768px) {
    .pricing-grid {
      grid-template-columns: 1fr;
      max-width: 350px;
      margin-left: auto;
      margin-right: auto;
    }
  }
</style>
