---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StripeButton from '../../components/StripeButton.astro';
import SupportTierCard from '../../components/SupportTierCard.astro';
import { getCollection } from 'astro:content';

const tiers = (await getCollection('supportTiers')).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout
  title="Support the Alma Consort | Friend, Partner, Patron"
  description="Become a Friend, Partner, or Patron of the Alma Consort. Your donation funds the Alma Scholars mentoring scheme for young choral singers in London."
  includeStripe={true}
>
  <div class="container">
    <h1>Support</h1>

    <div class="support-layout">
      <div class="support-text">
        <h2>Become a Friend, Partner, or Patron of Alma Consort</h2>
        <p>
          The Alma Consort is independent and runs on the support of its donors. We're fundraising for the Alma Scholars scheme, which provides mentoring for young singers.
        </p>
        <p>
          Make a one-off gift below, or set up a recurring donation as a Friend, Partner, or Patron.
        </p>
      </div>

      <div class="support-donate">
        <StripeButton buyButtonId="buy_btn_1SVCHuFZ0c2qbCCWyUgXt6Oa" />
      </div>
    </div>

    <div class="tier-cards">
      {tiers.map((tier) => (
        <SupportTierCard
          title={tier.data.title}
          slug={tier.data.slug}
          tagline={tier.data.tagline}
          cardImage={tier.data.cardImage}
        />
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .support-layout {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2.5rem;
    align-items: start;
    margin-bottom: 3rem;
  }

  .support-text h2 {
    font-variant: small-caps;
    letter-spacing: 0.03em;
  }

  .tier-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  @media (max-width: 768px) {
    .support-layout {
      grid-template-columns: 1fr;
    }

    .tier-cards {
      grid-template-columns: 1fr;
    }
  }
</style>
