---
import BaseLayout from '../layouts/BaseLayout.astro';
import TitleBlock from '../components/TitleBlock.astro';
import ContactForm from '../components/ContactForm.astro';
---
<BaseLayout
  title="Contact the Alma Consort"
  description="Contact Alma Consort for recording projects, concert bookings, wedding music, and general enquiries."
>
  <div class="container">
    <TitleBlock
      title="Contact"
      pitch={`We welcome enquiries about <span class="accent">recording projects, concert collaborations</span>, and other ways we might work together.`}
    />

    <ContactForm />
  </div>
</BaseLayout>
