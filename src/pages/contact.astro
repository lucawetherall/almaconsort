---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
---
<BaseLayout
  title="Contact the Alma Consort"
  description="Contact Alma Consort for recording projects, concert bookings, wedding music, and general enquiries."
>
  <div class="container">
    <h1>Contact</h1>

    <p class="contact-intro">
      We welcome enquiries about recording projects, concert collaborations, and other ways we might work together. Use the form below and we'll reply soon.
    </p>

    <ContactForm />
  </div>
</BaseLayout>

<style>
  .contact-intro {
    margin-bottom: 2rem;
    font-size: 1.05rem;
    line-height: 1.7;
  }
</style>
