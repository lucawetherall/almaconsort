---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';

const success = Astro.url.searchParams.get('success') === 'true';
---
<BaseLayout title="Contact" description="Contact the Alma Consort — for recording projects, concert bookings, and general enquiries.">
  <div class="container">
    <h1>Contact</h1>

    <p class="contact-intro">
      We welcome enquiries about recording projects, concert collaborations, and any other way we might work together. Please use the form below and we will respond promptly.
    </p>

    {success ? (
      <div class="success-message">
        <p><strong>Thank you!</strong> Your message has been sent. We will get back to you as soon as possible.</p>
        <p><a href={`${import.meta.env.BASE_URL}contact/`}>Send another message</a></p>
      </div>
    ) : (
      <ContactForm />
    )}
  </div>
</BaseLayout>

<style>
  .contact-intro {
    margin-bottom: 2rem;
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .success-message {
    padding: 2rem;
    background: var(--color-bg-white);
    border: 1px solid rgba(60, 60, 60, 0.1);
    border-radius: 4px;
    text-align: center;
  }
</style>
