---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Page Not Found" description="The page you are looking for could not be found." noindex={true}>
  <div class="container not-found">
    <h1>Page Not Found</h1>
    <p>Sorry, the page you're looking for doesn't exist or has moved.</p>
    <nav aria-label="Suggested pages">
      <ul>
        <li><a href={base}>Home</a></li>
        <li><a href={`${base}events/`}>Events</a></li>
        <li><a href={`${base}about/`}>About</a></li>
        <li><a href={`${base}contact/`}>Contact</a></li>
      </ul>
    </nav>
  </div>
</BaseLayout>

<style>
  .not-found {
    text-align: center;
    padding: 4rem 0;
  }

  .not-found p {
    font-size: 1.1rem;
    margin-bottom: 2rem;
  }

  nav ul {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    list-style: none;
  }

  nav a {
    font-family: var(--font-serif);
    font-size: 1rem;
    color: var(--color-text);
  }

  nav a:hover {
    color: var(--color-accent);
  }
</style>
