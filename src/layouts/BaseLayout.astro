---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Newsletter from '../components/Newsletter.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  includeStripe?: boolean;
  noindex?: boolean;
}

const {
  title,
  description = 'Alma Consort is a professional chamber choir in London, performing concerts and producing studio recordings across six centuries of vocal music.',
  ogImage,
  ogImageAlt = 'Alma Consort — professional chamber choir, London',
  includeStripe = false,
  noindex = false,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = ogImage
  ? new URL(ogImage, Astro.site).href
  : new URL(`${import.meta.env.BASE_URL}og-image.png`, Astro.site).href;

const displayTitle = title.includes('Alma Consort') ? title : `${title} | Alma Consort`;

const isHome = Astro.url.pathname === import.meta.env.BASE_URL;
const siteOrigin = new URL(import.meta.env.BASE_URL, Astro.site).href;
const webSiteId = siteOrigin + '#website';
const orgId = siteOrigin + '#org';

// Per-page WebPage JSON-LD (skip on homepage — already covered by WebSite + PerformingGroup below)
const webPageJsonLd = !isHome
  ? {
      "@context": "https://schema.org",
      "@type": "WebPage",
      "@id": canonicalUrl.href + '#webpage',
      "url": canonicalUrl.href,
      "name": displayTitle,
      "description": description,
      "inLanguage": "en-GB",
      "isPartOf": { "@id": webSiteId },
      "about": { "@id": orgId },
      "primaryImageOfPage": ogImageUrl,
    }
  : null;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <meta name="author" content="Alma Consort" />
    <meta name="theme-color" content="#f7f3e8" />
    <meta name="color-scheme" content="light" />
    <meta name="format-detection" content="telephone=no" />
    <title>{displayTitle}</title>

    <link rel="canonical" href={canonicalUrl.href} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <link rel="icon" type="image/png" sizes="64x64" href={`${import.meta.env.BASE_URL}favicon.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${import.meta.env.BASE_URL}logo.png`} />
    <link rel="manifest" href={`${import.meta.env.BASE_URL}site.webmanifest`} />
    <link rel="alternate" type="application/rss+xml" title="Alma Consort — News" href={`${import.meta.env.BASE_URL}rss.xml`} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={displayTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:site_name" content="Alma Consort" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={displayTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Stripe (support pages only) -->
    {includeStripe && (
      <script is:inline async src="https://js.stripe.com/v3/buy-button.js"></script>
    )}

    <!-- Google Analytics -->
    <!-- TODO: Replace G-XXXXXXXXXX with your GA4 measurement ID -->
    <!--
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-XXXXXXXXXX');
    </script>
    -->

    <!-- Structured Data: sitewide PerformingGroup (homepage only to avoid duplication) -->
    {isHome && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "PerformingGroup",
        "@id": orgId,
        "name": "Alma Consort",
        "alternateName": "The Alma Consort",
        "description": description,
        "url": siteOrigin,
        "logo": new URL(`${import.meta.env.BASE_URL}logo.png`, Astro.site).href,
        "image": new URL(`${import.meta.env.BASE_URL}og-image.png`, Astro.site).href,
        "genre": ["Choral Music", "Classical", "Contemporary", "Renaissance Polyphony", "Sacred Music"],
        "location": { "@type": "City", "name": "London", "address": { "@type": "PostalAddress", "addressLocality": "London", "addressCountry": "GB" } },
        "foundingLocation": { "@type": "City", "name": "London" },
        "areaServed": [
          { "@type": "City", "name": "London" },
          { "@type": "Country", "name": "United Kingdom" }
        ],
        "member": [
          { "@type": "Person", "name": "Luca Wetherall", "jobTitle": "Director" },
          { "@type": "Person", "name": "Izzy Mohan", "jobTitle": "Director" }
        ],
        "knowsAbout": ["Choral Recording", "Concert Performance", "Renaissance Polyphony", "Contemporary Choral Music", "Studio Sessions"],
        "sameAs": [
          "https://www.instagram.com/almaconsort/",
          "https://www.facebook.com/almaconsort/",
          "https://www.youtube.com/@almaconsort",
          "https://www.tiktok.com/@almaconsort"
        ]
      })} />
    )}

    <!-- Structured Data: sitewide WebSite -->
    {isHome && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebSite",
        "@id": webSiteId,
        "url": siteOrigin,
        "name": "Alma Consort",
        "description": description,
        "inLanguage": "en-GB",
        "publisher": { "@id": orgId }
      })} />
    )}

    <!-- Per-page WebPage -->
    {webPageJsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(webPageJsonLd)} />
    )}

    <slot name="head" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <Header />
    <main id="main-content">
      <div class="container">
        <Breadcrumbs />
      </div>
      <slot />
    </main>
    <div class="site-newsletter" id="newsletter">
      <div class="container">
        <Newsletter />
      </div>
    </div>
    <Footer />
  </body>
</html>
