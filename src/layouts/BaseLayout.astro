---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Newsletter from '../components/Newsletter.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  includeStripe?: boolean;
}

const {
  title,
  description = 'The Alma Consort is a professional chamber choir in London, dedicated to concerts and recordings of the highest calibre.',
  ogImage,
  includeStripe = false,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = ogImage
  ? new URL(ogImage, Astro.site).href
  : new URL(`${import.meta.env.BASE_URL}logo.png`, Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Alma Consort" />
    <title>{title} | Alma Consort</title>

    <link rel="canonical" href={canonicalUrl.href} />
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}favicon.png`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}logo.png`} />
    <link rel="alternate" type="application/rss+xml" title="Alma Consort — News" href={`${import.meta.env.BASE_URL}rss.xml`} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} | Alma Consort`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:site_name" content="Alma Consort" />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | Alma Consort`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400&display=swap" />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />

    <!-- Stripe (support pages only) -->
    {includeStripe && (
      <script is:inline async src="https://js.stripe.com/v3/buy-button.js"></script>
    )}

    <!-- Google Analytics -->
    <!-- TODO: Replace G-XXXXXXXXXX with your GA4 measurement ID -->
    <!--
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-XXXXXXXXXX');
    </script>
    -->

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "PerformingGroup",
      "name": "Alma Consort",
      "description": description,
      "url": canonicalUrl.href,
      "genre": ["Choral Music", "Classical", "Contemporary"],
      "location": {
        "@type": "City",
        "name": "London"
      },
      "foundingLocation": {
        "@type": "City",
        "name": "London"
      },
      "member": [
        {
          "@type": "Person",
          "name": "Luca Wetherall",
          "jobTitle": "Director"
        },
        {
          "@type": "Person",
          "name": "Izzy Mohan",
          "jobTitle": "Director"
        }
      ],
      "knowsAbout": ["Choral Recording", "Concert Performance"],
      "sameAs": [
        // TODO: Replace with actual social media profile URLs
        // "https://www.instagram.com/almaconsort/",
        // "https://www.youtube.com/@almaconsort",
        // "https://www.facebook.com/almaconsort"
      ]
    })} />

    <slot name="head" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <Header />
    <main id="main-content">
      <div class="container">
        <Breadcrumbs />
      </div>
      <slot />
    </main>
    <div class="site-newsletter">
      <div class="container">
        <Newsletter />
      </div>
    </div>
    <Footer />
  </body>
</html>
